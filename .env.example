# Public browser settings only. Fill independently for each isolated deployment.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy compatibility, only if the target project uses an anon key:
VITE_SUPABASE_ANON_KEY=
VITE_APP_ENV=dev

# Server-side (SSR / server functions): same URL and publishable key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional: opt-in integration test suite only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Never add service-role keys or database passwords to VITE_* variables.
